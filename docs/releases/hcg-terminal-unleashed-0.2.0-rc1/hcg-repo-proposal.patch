diff --git a/packages/com.hakmicapitalgroup.hcgterminal.unleashed/CHANGELOG.md b/packages/com.hakmicapitalgroup.hcgterminal.unleashed/CHANGELOG.md
index 91164f9..3772f08 100644
--- a/packages/com.hakmicapitalgroup.hcgterminal.unleashed/CHANGELOG.md
+++ b/packages/com.hakmicapitalgroup.hcgterminal.unleashed/CHANGELOG.md
@@ -2,6 +2,19 @@
 
 Entries are keyed by the exact Debian version in the package's control file (`## <version>`).
 
+## 0.2.0~rc1
+
+Frozen release candidate (SHA-256 `02626804763200f9e29d651a213bdb92330351d3052073e6a52cb86d62fc5a28`, 7,020,986 bytes),
+built by HCG-Terminal CI (commit `1cc76a7`, run 45051075163) with
+`Scripts/package-ios.sh unleashed … --deb rootless --ldid-entitlements HCGTerminal-Support/Unleashed-jailbreak.entitlements --deb-version 0.2.0~rc1`.
+
+- Job control in local shells: `hcg-pty-helper` makes the terminal the shell's controlling terminal (Ctrl-C/Z, window size, `/dev/tty`) and sets the working directory.
+- Every Mach-O is signed with `ldid` (the app with the reviewed no-sandbox entitlement only; the helper and the embedded Swift library with none). No Apple signature is mixed in any more.
+- Declares `uikittools` (its `postinst` runs `uicache`); maintainer scripts run only on configure / remove / purge.
+- Jailbreak Diagnostics (read-only): install location and signature, rootless bootstrap, dpkg health, repositories, tweak injection and Safe Mode clues, storage.
+- Navigation-only URL routes for HCG Nexus (`hcgterminal-unleashed://open/<screen>`).
+- Not yet verified on a physical device.
+
 ## 0.1.0-1
 
 First jailbreak package, built from HCG-Terminal commit `ddc5197` with the project's documented
diff --git a/packages/com.hakmicapitalgroup.hcgterminal.unleashed/package.toml b/packages/com.hakmicapitalgroup.hcgterminal.unleashed/package.toml
index ffb0fee..fa314d8 100644
--- a/packages/com.hakmicapitalgroup.hcgterminal.unleashed/package.toml
+++ b/packages/com.hakmicapitalgroup.hcgterminal.unleashed/package.toml
@@ -16,14 +16,14 @@ limitations = """
 - **Requires iOS 17.0 or later** (the package declares `firmware (>= 17.0)`). Sileo hides it on iOS 16 and earlier, including the iPhone 13 Pro on iOS 16.5 / Dopamine that HCG Nexus targets.
 - **Not yet run on a physical device.** Whether your jailbreak lets this signature and entitlement (`com.apple.private.security.no-sandbox`) start a shell is unverified.
 - Rootless only (`iphoneos-arm64`).
-- The app embeds Apple's `libswiftCompatibilitySpan.dylib` with Apple's original signature, while the app executable is `ldid`-signed. Whether your jailbreak loads that combination is part of the first device test.
-- The package's `postinst` calls `uicache` but does not declare `uikittools`. If the icon does not appear, run `uicache -a`.
+- Shell sessions run as the app's user (`mobile`). `sudo` runs only when you type it and asks for its own password.
 - Delete any sideloaded *HCG Terminal Unleashed* (Xcode, IPA, TrollStore) first: it uses the same bundle identifier.
 """
 install = """
 1. Remove any sideloaded copy of *HCG Terminal Unleashed*.
 2. Install **HCG Terminal Unleashed** in Sileo.
-3. Open the app, then *Settings › Unleashed Environment › Run Shell Test*. *Verified working* means a shell can start. *Permission denied* means this jailbreak does not accept the package's signing; please report it.
+3. Open the app, then *Unleashed Tools › Jailbreak Diagnostics*: *Install location* and *Signature and entitlements* should be OK.
+4. *Unleashed Tools › Environment and Tests › Run Shell Test*. *Verified working* means a shell can start. *Permission denied* means this jailbreak does not accept the package's signing; please report it.
 """
 removal = """
 1. Sileo → *Installed* → **HCG Terminal Unleashed** → *Remove*. The removal script unregisters the app icon.
@@ -51,3 +51,7 @@ allow_setuid = []
 [access]
 # Free for users signed in with HCG Connect. Never stored or served publicly here.
 level = "connect"
+# OWNER DECISION REQUIRED before 0.2.0~rc1 can enter the candidate channel (`candidate-protected`).
+# Left commented out: only the owner can approve an exception, per version (docs/ACCESS.md).
+# exception = "<who approved, when, why, scope: candidate channel only, this version only>"
+# exception_versions = ["0.2.0~rc1"]
