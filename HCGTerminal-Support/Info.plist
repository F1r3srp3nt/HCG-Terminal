<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates (GENERATE_INFOPLIST_FILE = YES). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>HCG Terminal connects to SSH hosts on your local network, such as your Mac, only when you open a session.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Build identity, shown in Diagnostics. HCG_BUILD_VARIANT is set per target
	     ("standard" or "unleashed"); HCGSourceRevision is stamped by
	     Scripts/stamp-build-info.sh during the build. -->
	<key>HCGBuildVariant</key>
	<string>$(HCG_BUILD_VARIANT)</string>
	<key>HCGSourceRevision</key>
	<string>unknown</string>
</dict>
</plist>
