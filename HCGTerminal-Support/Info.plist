<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates (GENERATE_INFOPLIST_FILE = YES). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>HCG Terminal connects to SSH hosts on your local network, such as your Mac, only when you open a session.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Build identity, shown in Diagnostics. HCG_BUILD_VARIANT is set per target
	     ("standard" or "unleashed"); HCGSourceRevision is stamped by
	     Scripts/stamp-build-info.sh during the build. -->
	<key>HCGBuildVariant</key>
	<string>$(HCG_BUILD_VARIANT)</string>
	<key>HCGSourceRevision</key>
	<string>unknown</string>
	<!-- HCG Nexus handoff, contract version 1 (docs/NEXUS-HANDOFF.md). HCG_URL_SCHEME is set
	     per target: "hcgterminal" (standard) or "hcgterminal-unleashed" (Unleashed), so the two
	     apps never claim the same scheme. Links can only bring the app forward or show a saved
	     connection; they never connect, run a command or start a session. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.hakmicapitalgroup.hcgterminal.nexus-handoff</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(HCG_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>HCGNexusHandoff</key>
	<integer>1</integer>
</dict>
</plist>
