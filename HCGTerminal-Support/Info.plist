<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates (GENERATE_INFOPLIST_FILE = YES). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>HCG Terminal connects to SSH hosts on your local network, such as your Mac, only when you open a session, and to an HCG Server you pair with in Connected Devices.</string>
	<!-- HCG Device Link: HCG Server is reached on the local network with a self-signed certificate
	     whose key is pinned from the invitation code (PinnedSessionTransport). ATS is relaxed for
	     local addresses only; every other connection keeps the default ATS rules. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Build identity, shown in Diagnostics. HCG_BUILD_VARIANT is set per target
	     ("standard" or "unleashed"); HCGSourceRevision is stamped by
	     Scripts/stamp-build-info.sh during the build. -->
	<key>HCGBuildVariant</key>
	<string>$(HCG_BUILD_VARIANT)</string>
	<key>HCGSourceRevision</key>
	<string>unknown</string>
</dict>
</plist>
