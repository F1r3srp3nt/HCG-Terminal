<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Unleashed target. Merged with the keys Xcode generates (GENERATE_INFOPLIST_FILE = YES).
	     Keep in step with Info.plist (standard target); only HCGInterchange differs. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>HCG Terminal connects to SSH hosts on your local network, such as your Mac, only when you open a session.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Build identity, shown in Diagnostics. HCG_BUILD_VARIANT is set per target
	     ("standard" or "unleashed"); HCGSourceRevision is stamped by
	     Scripts/stamp-build-info.sh during the build. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(HCG_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>hcgsentinel</string>
	</array>
	<key>HCGBuildVariant</key>
	<string>$(HCG_BUILD_VARIANT)</string>
	<key>HCGSourceRevision</key>
	<string>unknown</string>
	<!-- HCG Interchange Protocol v1 (HCG-Nexus docs/INTERCHANGE.md). Lets HCG Nexus open these screens directly
	     instead of through Unleashed Tools. A declaration can only narrow what Nexus offers; it is not an
	     authorization, and every route only navigates (TerminalDeepLink). -->
	<key>HCGInterchange</key>
	<dict>
		<key>protocol</key>
		<integer>1</integer>
		<key>product</key>
		<string>terminal-unleashed</string>
		<key>routes</key>
		<array>
			<string>jailbreak-diagnostics</string>
			<string>packages</string>
			<string>processes</string>
		</array>
	</dict>
</dict>
</plist>
